# --- LLM (keyless demo works without these) ---
OPENAI_API_KEY=
LLM_MODE=auto            # auto | templates
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Storage ---
# sqlite (dev) or postgresql+psycopg://user:pass@localhost:5432/earthpulse
DATABASE_URL=sqlite:///./earthpulse.db

# --- Operational scope ---
# chennai (15 zones, pilot) | tamilnadu (53 zones, all 38 districts)
SCOPE=chennai

# --- Real-data ingestion (optional; empty = honest demo mode) ---
IMD_ENDPOINT=
IMD_TOKEN=
GPM_ENDPOINT=
GPM_TOKEN=
RESERVOIR_ENDPOINT=
RESERVOIR_TOKEN=

# --- Demo behavior ---
SEED_ON_BOOT=true
TICK_SECONDS=3.0
CORS_ORIGINS=http://localhost:3000
